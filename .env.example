# Frontend variables use Vite's public prefix. Keep service-role keys out of the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PRIVATE_API_URL=http://localhost:8000

# FastAPI only. Never put these values in a VITE_ variable.
SUPABASE_JWT_SECRET=configure-a-supabase-jwt-secret
AADHAAR_ENCRYPTION_KEY=base64url-encoded-32-byte-key
ANTHROPIC_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-5-haiku-latest
GITHUB_TOKEN=optional-token-for-higher-readme-rate-limits
